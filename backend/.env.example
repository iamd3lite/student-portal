APP_NAME="FU ePortal API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL). Create the database first, e.g.:
#   mysql -u root -p -e "CREATE DATABASE student_portal CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
# then set the credentials below. NEVER commit the real .env to Git.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=student_portal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@fu.edu.ng"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Sanctum / SPA settings.
# FRONTEND_URL is where your HTML/CSS/JS is served from (Live Server, etc.).
# Add every origin your frontend uses to SANCTUM_STATEFUL_DOMAINS + CORS.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5500
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5500,127.0.0.1,127.0.0.1:5500,localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Seeded administrator bootstrap credentials (used by AdminSeeder).
ADMIN_NAME="System Administrator"
ADMIN_ADMIN_ID=ADM-2025-001
ADMIN_EMAIL=admin@fu.edu.ng
ADMIN_PASSWORD=ChangeMe!2025
